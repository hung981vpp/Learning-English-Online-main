    {
      "id": 1,
      "title": "Basic Vocabulary - Greetings",
      "description": "Từ vựng cơ bản về chào hỏi và giới thiệu",
      "topic": "Greetings",
      "level": "A1",
      "cards": [
        {
          "id": 1,
          "front": "Hello",
          "back": "Xin chào",
          "example": "Hello, how are you?",
          "phonetic": "/həˈloʊ/",
          "type": "interjection"
        },
        {
          "id": 2,
          "front": "Goodbye",
          "back": "Tạm biệt",
          "example": "Goodbye, see you tomorrow!",
          "phonetic": "/ɡʊdˈbaɪ/",
          "type": "interjection"
        },
        {
          "id": 3,
          "front": "Thank you",
          "back": "Cảm ơn",
          "example": "Thank you for your help.",
          "phonetic": "/θæŋk juː/",
          "type": "phrase"
        },
        {
          "id": 4,
          "front": "Please",
          "back": "Làm ơn",
          "example": "Please help me.",
          "phonetic": "/pliːz/",
          "type": "adverb"
        },
        {
          "id": 5,
          "front": "Sorry",
          "back": "Xin lỗi",
          "example": "Sorry, I am late.",
          "phonetic": "/ˈsɑːri/",
          "type": "adjective"
        },
        {
          "id": 6,
          "front": "Excuse me",
          "back": "Xin lỗi (để xin phép)",
          "example": "Excuse me, can I ask a question?",
          "phonetic": "/ɪkˈskjuːz miː/",
          "type": "phrase"
        },
        {
          "id": 7,
          "front": "Welcome",
          "back": "Chào mừng",
          "example": "Welcome to our school!",
          "phonetic": "/ˈwelkəm/",
          "type": "interjection"
        },
        {
          "id": 8,
          "front": "Nice to meet you",
          "back": "Rất vui được gặp bạn",
          "example": "Nice to meet you, John.",
          "phonetic": "/naɪs tuː miːt juː/",
          "type": "phrase"
        }
      ]
    },
